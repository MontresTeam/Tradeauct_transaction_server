# Tradeauct-transaction-server
#
# Every value below is required. The server refuses to start with any of them
# missing: a payment process that boots half-configured fails open later.
# Run `npm run keys:generate` for the SERVICE_* keys.

NODE_ENV=development
PORT=9100
# Loopback by default. This server is never internet-facing except for the
# Stripe webhook, which should reach it through the load balancer.
HOST=127.0.0.1
LOG_LEVEL=info
TRUST_PROXY=false

# Same database as TradeAuct_backend_server. Use the tradeauct_txn role in
# any deployed environment (see prisma/grants/roles.sql in the main repo).
DATABASE_URL=postgresql://user:password@localhost:5432/tradeauct

# Required: idempotency, replay defence and the outbox all depend on it.
REDIS_URL=redis://localhost:6379

# Verifies the end-user tokens the main server forwards. Must match the main
# server's JWT_SECRET.
JWT_SECRET=change-me-at-least-16-characters

# Stripe. This process is the only holder of the secret key in the platform.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_API_VERSION=2025-02-24.acacia

# Service-to-service credentials (npm run keys:generate)
SERVICE_NAME=txn-server
SERVICE_KEY_ID=
SERVICE_HMAC_SECRET=
SERVICE_JWT_PUBLIC_KEY_MAIN=
SERVICE_JWT_PRIVATE_KEY_TXN=
SERVICE_JWT_TTL_SECONDS=60
SERVICE_SIGNATURE_MAX_SKEW_SECONDS=120
SERVICE_REPLAY_WINDOW_SECONDS=300
# During a key rotation only:
# SERVICE_KEY_ID_PREVIOUS=
# SERVICE_HMAC_SECRET_PREVIOUS=

# Callbacks to the main server
MAIN_SERVER_URL=http://localhost:9000
# Comma-separated addresses permitted to reach /internal. Leave empty in local
# development; set it to the main server's address in every deployed
# environment.
INTERNAL_IP_ALLOWLIST=

# Queue names, shared with the main server
TXN_EVENTS_QUEUE=txn-events
TXN_COMMANDS_QUEUE=txn-commands
STRIPE_WEBHOOK_QUEUE=stripe-webhooks
SETTLEMENT_QUEUE=settlements

# ---------------------------------------------------------------------------
# Seller settlement and payout
# ---------------------------------------------------------------------------
#
# Two hard gates, both off by default. They are engineering kill switches and
# sit underneath the Super Admin toggles in SETTLEMENT_CONFIG: an admin turning
# "automatic payout" on does nothing while these are off. Both must be on
# before any money reaches a seller.
#
# They stay off in production until Stripe has verified the TradeAuct UAE
# account for Custom connected accounts and separate charges and transfers.
SELLER_CONNECT_ENABLED=false
SELLER_AUTO_TRANSFER_ENABLED=false

# Connect events are signed with their own secret and delivered to
# /webhooks/stripe/connect. Get it from:
#   stripe listen --forward-connect-to localhost:9100/webhooks/stripe/connect
# The Connect endpoint refuses deliveries while this is unset rather than
# accepting unverifiable ones.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Country for connected accounts this platform creates.
CONNECT_ACCOUNT_COUNTRY=AE

# Payout schedule set on new connected accounts.
#   manual - TradeAuct creates one payout per settlement: a clean 1:1 mapping,
#            but a payout fee each time.
#   daily  - Stripe pays out automatically and bundles several settlements into
#            one payout: cheaper, but each payout has to be attributed back to
#            the transfers it covers.
# This is the plan's open question Q4; manual is the safer default.
CONNECT_PAYOUT_INTERVAL=manual

# Where Stripe returns the seller after hosted onboarding.
SELLER_DASHBOARD_URL=http://localhost:5174
