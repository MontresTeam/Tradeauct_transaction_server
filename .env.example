# Tradeauct-transaction-server
#
# Every value below is required. The server refuses to start with any of them
# missing: a payment process that boots half-configured fails open later.
# Run `npm run keys:generate` for the SERVICE_* keys.

NODE_ENV=development
PORT=9100
# Loopback by default. This server is never internet-facing except for the
# Stripe webhook, which should reach it through the load balancer.
HOST=127.0.0.1
LOG_LEVEL=info
TRUST_PROXY=false

# Same database as TradeAuct_backend_server. Use the tradeauct_txn role in
# any deployed environment (see prisma/grants/roles.sql in the main repo).
DATABASE_URL=postgresql://user:password@localhost:5432/tradeauct

# Required: idempotency, replay defence and the outbox all depend on it.
REDIS_URL=redis://localhost:6379

# Verifies the end-user tokens the main server forwards. Must match the main
# server's JWT_SECRET.
JWT_SECRET=change-me-at-least-16-characters

# Stripe. This process is the only holder of the secret key in the platform.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_API_VERSION=2025-02-24.acacia

# Service-to-service credentials (npm run keys:generate)
SERVICE_NAME=txn-server
SERVICE_KEY_ID=
SERVICE_HMAC_SECRET=
SERVICE_JWT_PUBLIC_KEY_MAIN=
SERVICE_JWT_PRIVATE_KEY_TXN=
SERVICE_JWT_TTL_SECONDS=60
SERVICE_SIGNATURE_MAX_SKEW_SECONDS=120
SERVICE_REPLAY_WINDOW_SECONDS=300
# During a key rotation only:
# SERVICE_KEY_ID_PREVIOUS=
# SERVICE_HMAC_SECRET_PREVIOUS=

# Callbacks to the main server
MAIN_SERVER_URL=http://localhost:9000
# Comma-separated addresses permitted to reach /internal. Leave empty in local
# development; set it to the main server's address in every deployed
# environment.
INTERNAL_IP_ALLOWLIST=

# Queue names, shared with the main server
TXN_EVENTS_QUEUE=txn-events
TXN_COMMANDS_QUEUE=txn-commands
STRIPE_WEBHOOK_QUEUE=stripe-webhooks
