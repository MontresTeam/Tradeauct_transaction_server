enum AuctionStatus {
  PENDING
  ACTIVE
  RESERVE_NOT_MET
  RESERVE_MET
  ENDED_WITH_WINNER    // Timer hit zero, winner identified
  AWAITING_PAYMENT     // Winner confirmed, awaiting payment (post-end transparency state)
  ENDED_NO_BIDS        // No bids placed, listing expired
  ENDED_RESERVE_NOT_MET // Bids placed but reserve not met
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum PaymentRecoveryStatus {
  NOT_REQUIRED
  REQUIRED
  IN_PROGRESS
  RETRYING
  RECOVERED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PROCESSING
  PAID
  FAILED
  REQUIRES_ACTION
  REFUNDED
}

enum PaymentGateway {
  STRIPE
  ADYEN
  BANK_TRANSFER
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  EXCEPTION
}

enum AuctionType {
  RESERVE
  NO_RESERVE
  FROM_ZERO
}

enum BadgeStatus {
  ACTIVE
  INACTIVE
}

enum WeeklyAuctionStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

model WeeklyAuctionEvent {
  id                 String              @id @default(cuid())
  eventNumber        Int                 @unique @default(autoincrement()) @map("event_number")
  title              String
  startAt            DateTime            @map("start_at")
  closingStartAt     DateTime            @map("closing_start_at")
  cutOffAt           DateTime            @map("cut_off_at")
  lotIntervalMinutes Int                 @default(1) @map("lot_interval_minutes")
  status             WeeklyAuctionStatus @default(UPCOMING)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  auctions           Auction[]

  @@index([status])
  @@index([closingStartAt])
  @@map("weekly_auction_events")
}

model Auction {
  weeklyAuctionEventId String?             @map("weekly_auction_event_id")
  weeklyAuctionEvent   WeeklyAuctionEvent? @relation(fields: [weeklyAuctionEventId], references: [id], onDelete: SetNull)
  lotNumber            Int?                @map("lot_number")
  id               String                @id @default(cuid())
  listingId        String                @unique @map("product_id")
  listing          Listing               @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sellerId         String?               @map("seller_id")
  startingPrice    Float                 @map("starting_bid")
  reservePrice     Float?                @map("reserve_price")
  buyNowPrice      Float?                @map("buy_now_price")
  currentBid       Float?                @map("current_bid")
  startAt          DateTime              @map("auction_start_time")
  endAt            DateTime              @map("auction_end_time")
  status           AuctionStatus         @default(PENDING)
  auctionType      AuctionType           @default(RESERVE) @map("auction_type")
  reserveFee       Float?                @default(0) @map("reserve_fee")
  reserveFeeStatus String?               @default("FREE") @map("reserve_fee_status")

  // Authoritative Fee Snapshot
  feeRuleType                 String?   @map("fee_rule_type")
  sellerFeePercentSnapshot    Float?    @map("seller_fee_percent_snapshot")
  buyerPremiumPercentSnapshot Float?    @map("buyer_premium_percent_snapshot")
  minimumStartingBidSnapshot  Float?    @map("minimum_starting_bid_snapshot")
  feeConfigurationVersion     String?   @map("fee_configuration_version")
  feeSnapshotCreatedAt        DateTime? @map("fee_snapshot_created_at")

  // Cancellation metadata
  cancelledBy                 String?   @map("cancelled_by") // "SELLER", "ADMIN", "SYSTEM"
  cancellationReason          String?   @map("cancellation_reason")
  cancellationInternalNote    String?   @map("cancellation_internal_note")
  cancellationPrivilegeUsed   Boolean   @default(false) @map("cancellation_privilege_used")
  cancelledAt                 DateTime? @map("cancelled_at")
  cancelledById               String?   @map("cancelled_by_id")

  winnerId         String?               @map("winner_id")
  winner           Buyer?                @relation(fields: [winnerId], references: [id], onDelete: SetNull)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  bids             Bid[]
  badges           AuctionBadgeMapping[]

  @@index([status])
  @@index([endAt])
  @@index([auctionType])
  @@index([weeklyAuctionEventId])
  @@map("auctions")
}

model AuctionSetting {
  id           String   @id @default(cuid())
  settingName  String   @unique @map("setting_name")
  settingValue String   @map("setting_value")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("auction_settings")
}

model AuctionBadge {
  id           String                @id @default(cuid())
  name         String                @unique
  description  String
  icon         String
  displayOrder Int                   @default(0) @map("display_order")
  status       BadgeStatus           @default(ACTIVE)
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  mappings     AuctionBadgeMapping[]

  @@map("auction_badges")
}

model AuctionBadgeMapping {
  id        String       @id @default(cuid())
  auctionId String       @map("auction_id")
  auction   Auction      @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  badgeId   String       @map("badge_id")
  badge     AuctionBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([auctionId, badgeId])
  @@index([auctionId])
  @@index([badgeId])
  @@map("auction_badge_mapping")
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String   @map("auction_id")
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderId  String   @map("bidder_id")
  bidder    Buyer    @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  amount    Float    @map("bid_amount")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([auctionId, amount(sort: Desc)])
  @@index([bidderId])
  @@map("auction_bids")
}

model AuctionIncrementRule {
  id             String   @id @default(cuid())
  minimumAmount  Float    @map("minimum_amount")
  maximumAmount  Float?   @map("maximum_amount")
  incrementValue Float    @map("increment_value")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([minimumAmount])
  @@map("auction_increment_rules")
}

model Offer {
  id        String      @id @default(cuid())
  listingId String
  listing   Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     Buyer       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  amount    Float
  currency  String      @default("AED")
  message   String?
  status    OfferStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([listingId, status])
  @@index([buyerId])
}

model Payment {
  id                    String            @id @default(cuid())
  listingId             String            @unique
  listing               Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  auctionId             String?
  buyerId               String
  buyer                 Buyer             @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId              String?
  stripeCustomerId      String?
  stripePaymentMethodId String?
  amount                Float
  amountMinor           BigInt?
  currency              String            @default("AED")
  currencyExponent      Int               @default(2)
  gateway               PaymentGateway    @default(STRIPE)
  gatewayTransactionId  String?           @unique
  stripePaymentIntentId String?           @unique
  /// The intent's latest_charge, persisted at finalization. A later seller
  /// transfer names it as its source_transaction.
  stripeChargeId        String?
  /// Ties the buyer's charge and the seller's transfer together in Stripe.
  transferGroup         String?
  status                PaymentStatus     @default(PENDING)
  failureReason         String?
  paymentRecoveryStatus PaymentRecoveryStatus @default(NOT_REQUIRED)
  recoveryRequiredAt    DateTime?
  recoveryStartedAt     DateTime?
  recoveryExpiresAt     DateTime?
  recoveryAttemptCount  Int                   @default(0)
  lastRecoveryAttemptAt DateTime?
  lastFailureCode       String?
  lastFailureMessage    String?
  recoveryReason        String?
  isTechnicalFailure    Boolean               @default(false)
  paidAt                DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  shipment              Shipment?
  fulfillmentOrder      FulfillmentOrder?

  @@index([buyerId])
  @@index([auctionId])
  @@index([stripeChargeId])
}

model SavedPaymentMethod {
  id                    String   @id @default(cuid())
  buyerId               String
  buyer                 Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  stripeCustomerId      String
  stripePaymentMethodId String   @unique
  brand                 String
  last4                 String
  expMonth              Int?
  expYear               Int?
  status                String   @default("active")
  isDefault             Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([buyerId])
  @@index([stripeCustomerId])
}

model Shipment {
  id             String         @id @default(cuid())
  paymentId      String         @unique
  payment        Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  courier        String // e.g. "DHL", "FedEx"
  trackingNumber String?        @unique
  status         ShipmentStatus @default(PENDING)
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

