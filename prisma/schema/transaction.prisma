  orderNumber       String                   @unique
  paymentId         String?                  @unique
  payment           Payment?                 @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  listingId         String                   @unique
  listing           Listing                  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId           String
  buyer             Buyer                    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId          String
  seller            Seller                   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  purchaseType      SaleType                 @default(AUCTION)
  purchasePrice     Float
  buyerFee          Float                    @default(0)
  shippingCost      Float                    @default(0)
  storageFee        Float                    @default(0)
  taxAmount         Float                    @default(0)
  totalAmount       Float
  currency          String                   @default("AED")
  storageSelected   Boolean                  @default(false)

  fulfillmentStatus FulfillmentStatus        @default(PAYMENT_COMPLETED)
  inspectionStatus  InspectionStatus         @default(NOT_REQUIRED)

