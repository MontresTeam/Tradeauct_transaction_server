enum DisputeReason {
  ITEM_NOT_AS_DESCRIBED
  MISSING_ITEM_OR_ACCESSORY
  CONDITION_ISSUE
  AUTHENTICITY_CONCERN
  FUNCTIONAL_MECHANICAL_ISSUE
  SHIPPING_DAMAGE
  WRONG_ITEM
  RETURN_REFUND_ISSUE
  OTHER
  // Explicit category aliases for TradeAuct dispute guidelines
  COUNTERFEIT_AUTHENTICITY
  SIGNIFICANTLY_NOT_AS_DESCRIBED
  UNDISCLOSED_DEFECT
  MISSING_ACCESSORIES
  BUYER_REMORSE
}

enum DisputeStatus {
  CASE_OPENED
  EVIDENCE_REQUIRED
  UNDER_REVIEW
  RESOLVED
}

enum DisputeResolutionOutcome {
  RELEASE_FUNDS_TO_SELLER
  FULL_REFUND_TO_BUYER
  PARTIAL_REFUND_ADJUSTMENT
  RETURN_ITEM_BEFORE_REFUND
  CLAIM_REJECTED_CLOSED
}

/// Settlement lifecycle.
///
/// The live states are PENDING → ON_HOLD → ELIGIBLE → TRANSFER_PENDING →
/// TRANSFERRED → PAID_OUT, with FROZEN, DISPUTED, TRANSFER_FAILED, REFUNDED
/// and CANCELLED as the exception branches.
///
/// Note that ON_HOLD changed meaning: it now means "delivered, protection
/// window running", not "an admin put a hold on it". An admin hold is
/// FROZEN with frozenReason = ADMIN_HOLD.
///
/// The members below the divider are retained only so the pre-automation rows
/// still parse. Nothing writes them. The data migration maps them across; see
/// payment_settlement_implementation_plan.md §6.
enum SettlementStatus {
  PENDING
  ON_HOLD
  ELIGIBLE
  TRANSFER_PENDING
  TRANSFERRED
  PAID_OUT
  FROZEN
  DISPUTED
  TRANSFER_FAILED
  REFUNDED
  CANCELLED

  // --- deprecated, read-only ---
  DISPUTE_OPEN
  RETURN_IN_PROGRESS
  AVAILABLE_FOR_PAYOUT
  PAID
}

/// Why a settlement is frozen. Kept alongside the status so unfreezing can
/// return the settlement to exactly the state it came from.
enum SettlementFrozenReason {
  ADMIN_HOLD
  RETURN
  BUYER_DISPUTE_CASE
  UNRESOLVED_ISSUE
  RECONCILIATION_EXCEPTION
}

/// A debt owed back to the platform after the seller has already been paid.
enum SettlementRecoveryStatus {
  OPEN
  PARTIALLY_RECOVERED
  RECOVERED
  WRITTEN_OFF
}

enum SettlementRecoveryCause {
  REFUND_AFTER_PAYOUT
  DISPUTE_LOST_AFTER_PAYOUT
  CHARGEBACK
  MANUAL_ADJUSTMENT
}

enum PayoutStatus {
  UNPAID
  REQUESTED
  APPROVED
  PROCESSING
  PAID
  REJECTED
}

enum WalletTransactionType {
  SETTLEMENT_CREDIT
  WITHDRAWAL
  ADJUSTMENT_DEBIT
  ADJUSTMENT_CREDIT
  REFUND_DEDUCTION
}

model DisputeCase {
  id                 String                   @id @default(cuid())
  caseNumber         String                   @unique
  fulfillmentOrderId String                   @unique
  fulfillmentOrder   FulfillmentOrder         @relation(fields: [fulfillmentOrderId], references: [id], onDelete: Cascade)

  reason             DisputeReason            @default(ITEM_NOT_AS_DESCRIBED)
  reasonDetails      String?
  status             DisputeStatus            @default(CASE_OPENED)
  resolutionOutcome  DisputeResolutionOutcome?

  openedById         String
  openedByRole       FulfillmentActorRole     @default(BUYER)
  claimSummary       String
  disputedAmount     Float
  currency           String                   @default("AED")

  recommendedAction  String?
  responseDeadline   DateTime?

  thirdPartyRequired Boolean                  @default(false)
  thirdPartyAssessor String?
  thirdPartyReport   String?

  evidenceList       DisputeEvidence[]
  timeline           DisputeMilestone[]

  adminNotes         String?
  resolvedAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([status])
  @@index([fulfillmentOrderId])
}

model DisputeEvidence {
  id            String               @id @default(cuid())
  disputeCaseId String
  disputeCase   DisputeCase          @relation(fields: [disputeCaseId], references: [id], onDelete: Cascade)

  uploadedById  String
  uploadedByRole FulfillmentActorRole @default(SELLER)
  fileType      String               // "IMAGE", "VIDEO", "DOCUMENT", "TEXT"
  fileUrl       String?
  fileName      String?
  fileSizeBytes Int?
  notes         String?

  createdAt     DateTime             @default(now())

  @@index([disputeCaseId])
}

model DisputeMilestone {
  id            String               @id @default(cuid())
  disputeCaseId String
  disputeCase   DisputeCase          @relation(fields: [disputeCaseId], references: [id], onDelete: Cascade)

  title         String
  description   String
  isCompleted   Boolean              @default(true)
  performedBy   String?
  createdAt     DateTime             @default(now())

  @@index([disputeCaseId])
}

model SellerSettlement {
  id                   String           @id @default(cuid())
  settlementNumber     String           @unique

  /// The settlement is created when the payment is recorded, which is before
  /// the main server has built the fulfilment order — so this is nullable and
  /// linked later by the FULFILLMENT_ORDER_CREATED command.
  fulfillmentOrderId   String?           @unique
  fulfillmentOrder     FulfillmentOrder? @relation(fields: [fulfillmentOrderId], references: [id], onDelete: SetNull)

  /// The real key. One paid payment, one settlement.
  paymentId            String?          @unique

  sellerId             String
  seller               Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  // Dynamic Platform Fee Snapshot (Admin-configured dynamic fee structure)
  saleAmount           Float
  currency             String           @default("AED")
  platformFeeRate      Float            // Effective rate snapshot from dynamic Admin rule (no hard-coded default)
  platformFeeType      String           @default("PERCENTAGE") // "PERCENTAGE", "FIXED", "TIERED"
  platformFee          Float            // Calculated platform fee amount

  // Shipping Responsibility Snapshot
  shippingPayer        ShippingPayer    @default(BUYER) // BUYER or SELLER
  estimatedShipping    Float            @default(0)
  actualShipping       Float            @default(0)
  actualShippingKnown  Boolean          @default(false)

  // Deductions & Adjustments
  otherDeductions      Float            @default(0)
  refundAmount         Float            @default(0)
  adjustmentAmount     Float            @default(0)
  netProceeds          Float            // Sale Amount - Platform Fee - (Actual Shipping if Seller Pays) - Deductions

  // Fee Engine snapshot, copied onto the settlement at payment time so a later
  // change to the fee configuration cannot move an order that already sold.
  feeRuleType             String?
  feeConfigurationVersion String?
  sellerFeePercent        Float?
  buyerFeePercent         Float?
  sellerFeeAmount         Float?
  buyerFeeAmount          Float?
  feeCalculatedAt         DateTime?

  // Status & Lifecycle Timestamps
  settlementStatus     SettlementStatus @default(PENDING)
  payoutStatus         PayoutStatus     @default(UNPAID)
  holdReason           String?
  holdPlacedById       String?
  holdPlacedAt         DateTime?

  /// Why the settlement is frozen, and what state to put it back into.
  frozenReason         SettlementFrozenReason?
  frozenFromStatus     SettlementStatus?
  frozenAt             DateTime?

  deliveredAt          DateTime?
  deliverySource       String?
  receiptConfirmedAt   DateTime?
  autoReceiptAt        DateTime?

  /// Snapshotted from SETTLEMENT_CONFIG at delivery, so an admin changing the
  /// period never moves an order that is already in its window.
  protectionPeriodDays Int?
  protectionExpiresAt  DateTime?
  eligibleAt           DateTime?
  settledAt            DateTime?

  // Stripe transfer / payout tracking. A transfer moves money to the seller's
  // connected account; a payout moves it from there to their bank. They are
  // separate events and are tracked separately.
  stripeConnectedAccountId String?
  stripeTransferId         String?
  stripeTransferStatus     String?
  transferredAt            DateTime?
  stripePayoutId           String?
  stripePayoutStatus       String?
  paidOutAt                DateTime?
  payoutMethod             String?
  transferFailureCode      String?
  transferFailureMessage   String?
  transferAttempts         Int              @default(0)

  /// True while money is owed back after the seller was already paid. The
  /// status stays PAID_OUT — history is never rewritten.
  hasOpenRecovery      Boolean          @default(false)

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  adjustments          SettlementAdjustment[]
  auditLogs            FinancialAuditLog[]
  recoveries           SettlementRecovery[]

  @@index([sellerId])
  @@index([settlementStatus])
  @@index([payoutStatus])
  @@index([settlementStatus, eligibleAt])
  @@index([hasOpenRecovery])
}

/// Money owed back to the platform after a payout has already gone out.
///
/// A refund or a lost dispute after PAID_OUT never edits the settlement's
/// status. It opens one of these instead, which is then either reversed out of
/// the connected account's balance or offset against the seller's next
/// transfers.
model SettlementRecovery {
  id                  String                   @id @default(cuid())
  settlementId        String
  settlement          SellerSettlement         @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  sellerId            String

  cause               SettlementRecoveryCause
  status              SettlementRecoveryStatus @default(OPEN)
  amountMinor         BigInt
  recoveredMinor      BigInt                   @default(0)
  currency            String                   @default("AED")

  /// Set when part or all of the debt was pulled back out of the connected
  /// account rather than offset against a future settlement.
  stripeTransferReversalId String?

  sourceType          String?
  sourceId            String?
  notes               String?
  resolvedAt          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([sellerId, status])
  @@index([settlementId])
  @@map("settlement_recoveries")
}

enum ReconciliationExceptionStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  IGNORED
}

/// A disagreement between TradeAuct's records and Stripe's, raised by the
/// hourly reconciliation job for a person to look at.
model ReconciliationException {
  id             String                        @id @default(cuid())
  kind           String
  severity       String                        @default("WARNING")
  entityType     String
  entityId       String
  expectedMinor  BigInt?
  actualMinor    BigInt?
  currency       String                        @default("AED")
  detail         Json?
  status         ReconciliationExceptionStatus @default(OPEN)
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  firstSeenAt    DateTime                      @default(now())
  lastSeenAt     DateTime                      @default(now())
  occurrences    Int                           @default(1)

  @@unique([kind, entityType, entityId])
  @@index([status, severity])
  @@map("reconciliation_exceptions")
}

model SettlementAdjustment {
  id                 String           @id @default(cuid())
  settlementId       String
  settlement         SellerSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  adminId            String
  previousNet        Float
  adjustmentAmount   Float            // Positive or negative adjustment
  newNet             Float
  reason             String
  createdAt          DateTime         @default(now())

  @@index([settlementId])
}

model SellerWallet {
  id                 String              @id @default(cuid())
  sellerId           String              @unique
  seller             Seller              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  pendingEarnings    Float               @default(0)
  availableBalance   Float               @default(0)
  totalWithdrawn     Float               @default(0)
  currency           String              @default("AED")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  transactions       WalletTransaction[]
  payouts            SellerPayout[]

  @@index([sellerId])
}

model WalletTransaction {
  id             String                @id @default(cuid())
  walletId       String
  wallet         SellerWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type           WalletTransactionType
  amount         Float
  balanceBefore  Float
  balanceAfter   Float
  currency       String                @default("AED")
  referenceId    String?               // e.g. settlementId, payoutId
  referenceType  String?               // "SETTLEMENT", "PAYOUT", "ADJUSTMENT"
  description    String
  metadata       Json?
  createdAt      DateTime              @default(now())

  @@index([walletId])
  @@index([referenceId])
}

model SellerPayout {
  id                 String       @id @default(cuid())
  payoutNumber       String       @unique
  walletId           String
  wallet             SellerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  sellerId           String
  seller             Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  amount             Float
  currency           String       @default("AED")
  status             PayoutStatus @default(REQUESTED)
  bankAccountDetails Json?
  adminNotes         String?
  processedById      String?
  processedAt        DateTime?
  rejectionReason    String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([sellerId])
  @@index([status])
}

model FinancialAuditLog {
  id              String            @id @default(cuid())
  action          String            // e.g. "SETTLEMENT_CREATED", "ACTUAL_SHIPPING_RECORDED", "HOLD_PLACED", "HOLD_RELEASED", "SETTLEMENT_RELEASED", "PAYOUT_PROCESSED"
  entityType      String            // "SETTLEMENT", "WALLET", "PAYOUT", "SHIPPING_RATE"
  entityId        String
  amount          Float?
  previousState   Json?
  newState        Json?
  reason          String?
  performedById   String?
  performedByRole String            @default("SYSTEM") // "SYSTEM", "ADMIN", "SELLER", "BUYER"
  metadata        Json?
  settlementId    String?
  settlement      SellerSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())

  @@index([entityType, entityId])
  @@index([action])
}

model CountryShippingRate {
  id             String   @id @default(cuid())
  countryCode    String   @unique // e.g. "AE", "SA", "KW", "QA", "OM", "BH", "GB", "US"
  countryName    String
  zone           String   @default("GCC") // "DOMESTIC", "GCC", "WORLDWIDE", "EUROPE", etc.
  shippingMethod String   @default("TradeAuct Insured Express")
  rate           Float    // Base rate e.g. AED 25, AED 80
  currency       String   @default("AED")
  isActive       Boolean  @default(true)
  estimatedDays  String?  @default("2-4 business days")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([countryCode])
  @@index([isActive])
}

model StripeEventLog {
  id        String   @id @default(cuid())
  eventId   String   @unique
  eventType String
  status    String   @default("PROCESSED")
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([eventType])
  @@map("stripe_event_logs")
}

model ProcessedEvent {
  id          String   @id @default(cuid())
  eventId     String
  consumer    String
  processedAt DateTime @default(now())

  @@unique([eventId, consumer])
  @@map("processed_events")
}
