enum CoverageType {
  COUNTRY
  ZONE
  WORLDWIDE
}

enum PricingType {
  FIXED_FEE
  ZONE_BASED
  WEIGHT_BASED
  MANUAL_QUOTE
}

enum InsuranceType {
  FIXED
  PERCENTAGE
}

model Courier {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shippingRules ShippingRule[]

  @@map("couriers")
}

model ShippingCoverageZone {
  id                  String   @id @default(cuid())
  name                String   @unique
  code                String   @unique
  description         String?
  isWorldwideFallback Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  countries     ShippingCoverageZoneCountry[]
  shippingRules ShippingRule[]
  zoneRates     ShippingRuleZoneRate[]

  @@map("shipping_coverage_zones")
}

model ShippingCoverageZoneCountry {
  id          String               @id @default(cuid())
  zoneId      String
  countryCode String
  countryName String
  createdAt   DateTime             @default(now())

  zone        ShippingCoverageZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, countryCode])
  @@index([countryCode])
  @@map("shipping_coverage_zone_countries")
}

model ShippingRule {
  id                       String                @id @default(cuid())
  name                     String
  courierId                String
  coverageType             CoverageType          @default(ZONE)
  zoneId                   String?
  targetCountryCode        String?

  pricingType              PricingType           @default(FIXED_FEE)
  baseShippingFee          Decimal               @default(0.00) @db.Decimal(10, 2)
  currency                 String                @default("AED")

  // Weight Surcharge
  enableWeightSurcharge    Boolean               @default(false)
  includedWeightKg         Decimal?              @db.Decimal(8, 2)
  extraWeightUnitKg        Decimal?              @db.Decimal(8, 2)
  extraFeePerUnit          Decimal?              @db.Decimal(10, 2)

  // Insurance Surcharge
  enableInsuranceSurcharge Boolean               @default(false)
  insuranceType            InsuranceType?        @default(PERCENTAGE)
  insuranceAmount          Decimal?              @db.Decimal(10, 2)
  minInsuranceFee          Decimal?              @db.Decimal(10, 2)
  maxInsuranceFee          Decimal?              @db.Decimal(10, 2)

  // Delivery Timeline
  minDeliveryDays          Int                   @default(1)
  maxDeliveryDays          Int                   @default(3)

  notes                    String?
  isActive                 Boolean               @default(true)
  isArchived               Boolean               @default(false)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  courier                  Courier               @relation(fields: [courierId], references: [id], onDelete: Restrict)
  zone                     ShippingCoverageZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  zoneRates                ShippingRuleZoneRate[]

  @@index([courierId])
  @@index([zoneId])
  @@map("shipping_rules")
}

model ShippingRuleZoneRate {
  id             String                @id @default(cuid())
  shippingRuleId String
  zoneId         String?
  countryCode    String?
  countryName    String?
  rate           Decimal               @db.Decimal(10, 2)
  estimatedDays  String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  shippingRule   ShippingRule          @relation(fields: [shippingRuleId], references: [id], onDelete: Cascade)
  zone           ShippingCoverageZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@unique([shippingRuleId, countryCode])
  @@map("shipping_rule_zone_rates")
}
