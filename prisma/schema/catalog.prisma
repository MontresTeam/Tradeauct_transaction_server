model Country {
  id                  String          @id @default(cuid())
  name                String          @unique
  code                String          @unique // ISO Alpha-2 e.g. "CH", "US", "AE", "ZA", "SA"
  flag                String?
  defaultLanguageCode String          @default("en")
  defaultCurrencyCode String          @default("AED")
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  brands              Brand[]
  sellerAddresses     SellerAddress[]
  buyerAddresses      BuyerAddress[]
}

