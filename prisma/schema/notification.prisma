/// Schema drift, closed 2026-09-23: the live database's enum carried 13
/// members this file never declared (ORDER_CREATED through ADMIN_ORDER_ALERT
/// below), added at some point by a `db push` from a branch of the code that
/// created fulfilment-status notifications. That code path is gone, but the
/// historical rows are not, and a Prisma client generated from a schema
/// missing a value it finds in a live row throws — "Value 'X' not found in
/// enum" — the moment `getNotifications` tries to read a row of that type.
/// The members are listed here to match the database exactly, not because
/// anything still creates them going forward.
enum NotificationType {
  NEW_QUESTION_FOR_SELLER
  ANSWER_APPROVED
  ANSWER_REJECTED
  ANSWER_CLARIFICATION_REQUESTED
  QUESTION_ANSWERED
  LISTING_SUBMITTED
  LISTING_APPROVED
  LISTING_REJECTED
  AUCTION_STARTED
  BID_RECEIVED
  OUTBID
  AUCTION_WON
  PAYMENT_REQUIRED
  PAYMENT_SUCCESS
  ORDER_SHIPPED
  PAYOUT_RELEASED
  SELLER_APPLICATION_SUBMITTED
  SELLER_APPLICATION_APPROVED
  SELLER_APPLICATION_REJECTED
  SELLER_APPLICATION_RESUBMITTED
  SELLER_APPLICATION_SUSPENDED

  // --- present in the database; nothing currently creates these ---
  ORDER_CREATED
  SELLER_ACTION_REQUIRED
  SELLER_PACKAGE_PREPARED
  ORDER_IN_TRANSIT_TO_HUB
  HUB_INTAKE_COMPLETED
  INSPECTION_PASSED
  INSPECTION_FAILED
  INSPECTION_UPDATE
  READY_FOR_SHIPMENT
  ORDER_SHIPPED_DHL
  ORDER_DELIVERED
  ORDER_CONFIRMED
  ADMIN_ORDER_ALERT
}

model Notification {
  id            String           @id @default(cuid())
  userId        String?
  user          User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientId   String?
  recipientRole String?
  listingId     String?
  listing       Listing?         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type          NotificationType
  title         String
  message       String
  data          Json?
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([userId, isRead])
  @@index([recipientId])
  @@index([recipientRole])
  @@index([isRead])
  @@index([createdAt])
  @@index([listingId])
}