{
  "name": "tradeauct-transaction-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "// --- Server Development & Build ---": "",
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "// --- Database (Transaction Server is the migration authority) ---": "",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "// --- Service key management ---": "",
    "keys:generate": "tsx scripts/generate-service-keys.ts",
    "// --- Linting, Formatting & Testing ---": "",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "// --- Stripe Tooling ---": "",
    "stripe:listen": "stripe listen --forward-to localhost:9100/webhooks/stripe",
    "smoke": "tsx scripts/smoke-internal.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bullmq": "^5.80.9",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.22.0",
    "stripe": "^22.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.20.1",
    "prisma": "^6.19.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
